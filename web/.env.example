# Public Supabase values. The anon key is meant for browsers; Row Level Security
# is what keeps drafts and writes closed. Do not put the service-role key here.
# Project URL only, for example https://your-project.supabase.co
# A copied /rest/v1 suffix is ignored.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required only for account pages. Use http://localhost:3000 locally.
# Auth pages say accounts are unavailable when this is missing.
NEXT_PUBLIC_SITE_URL=

# Server-only. Do not prefix with NEXT_PUBLIC_.
# xAI API key for SpaceMatch. Leave blank to use the labeled local parser.
XAI_API_KEY=
# Optional model id. Defaults to grok-4.7.
XAI_MODEL=
# Optional API root. Defaults to https://api.x.ai/v1.
XAI_API_BASE_URL=
